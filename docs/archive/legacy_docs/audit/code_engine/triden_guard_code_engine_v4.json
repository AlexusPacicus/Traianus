            "parameters": {
                "jsCode": "/**\n * TRIDENGUARD: Antigravity Code Compiler v4.0\n * Role: Neuro-Symbolic Validator\n * Objective: Schema-constrained validation with physical security gates.\n */\n\nfor (const item of $input.all()) {\n  const output = item.json.output || {};\n  const safety_abort = output.Safety_Abort || \"NONE\";\n  const original_code = $(\"Frontend Webhook\").item.json.body?.text || \"\";\n\n  // 1. GATE DE ABORTO (Safety Check)\n  if (safety_abort !== \"NONE\") {\n      item.json.final_decision = \"BLOCKED_BY_SAFETY_GATE\";\n      item.json.abort_reason = safety_abort;\n      item.json.status = \"QUARANTINED\";\n      item.json.case_id = crypto.randomUUID();\n      item.json.timestamp = new Date().toISOString();\n      continue;\n  }\n\n  // 2. GATE DE CONTRATO (Deterministic Block)\n  const block = output.Implementation_Block || \"\";\n  if (block.includes(\"fetch(\") || block.includes(\"axios\")) {\n      item.json.final_decision = \"ABORTED_VIOLATES_ZERO_TRUST\";\n      item.json.status = \"QUARANTINED\";\n      item.json.case_id = crypto.randomUUID();\n      item.json.timestamp = new Date().toISOString();\n      continue;\n  }\n\n  // 3. GATE DE GROUNDING (Literal Check)\n  const intent = output.Intent_Class || \"NONE\";\n  if ([\"REFACTOR\", \"FIX\", \"AUDIT\"].includes(intent)) {\n      const quote = output.Topological_Grounding;\n      if (!quote || quote === \"N/A\" || !original_code.includes(quote)) {\n          item.json.final_decision = \"ABORTED_GROUNDING_FAILED\";\n          item.json.status = \"QUARANTINED\";\n          item.json.case_id = crypto.randomUUID();\n          item.json.timestamp = new Date().toISOString();\n          continue;\n      }\n  }\n\n  // Successful Pass\n  item.json.final_decision = \"EXECUTE_SAFE\";\n  item.json.status = \"VALIDATED\";\n  item.json.case_id = crypto.randomUUID();\n  item.json.timestamp = new Date().toISOString();\n  item.json.and_gate_ok = true;\n  item.json.compiler_payload = JSON.stringify(output);\n}\n\nreturn $input.all();"
            },
